# ============================================================
# Safe Method / Gatekeeper — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables below are REQUIRED unless marked (optional).
# ============================================================

# ── Anthropic API ────────────────────────────────────────────
# Used by: core/generate.py, core/document_extractor.py,
#          core/swms_analyser.py, renderers/docx_renderer.py,
#          agents/*.py, api/main.py, db/seed_*.py
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase Auth ────────────────────────────────────────────
# Used by: core/auth.py (JWT verification, signup, login, refresh)
# Find these in your Supabase project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Frontend / CORS ─────────────────────────────────────────
# Used by: core/auth.py (CORS origin, redirect URLs)
# Set to your deployed domain in production
FRONTEND_URL=http://localhost:8000

# ── Server ───────────────────────────────────────────────────
# Used by: start.py (Railway/production entry point)
# Railway sets this automatically — no need to configure manually
# (optional) PORT=8080
PORT=8080
